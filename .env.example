DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AWS_REGION=us-east-1
AWS_S3_BUCKET=dashboard-documents

# Per-user cap on document + image storage within a single project, in bytes. Default: 10 MB.
MAX_USER_UPLOAD_BYTES_PER_PROJECT=10485760

# Shared secret the resize Lambda sends back as X-Internal-Token - must match
# the value configured on the Lambda (see infra/aws/README.md).
INTERNAL_CALLBACK_TOKEN=change-me-internal-token
