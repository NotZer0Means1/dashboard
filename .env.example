DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AWS_REGION=us-east-1
AWS_S3_BUCKET=dashboard-documents

# Per-user cap on document + image storage within a single project, in bytes.
# A resized image counts twice: the original is kept as the resize source.
# Default: 10 MB.
MAX_USER_UPLOAD_BYTES_PER_PROJECT=10485760

# Shared secret guarding /internal/... - the resize Lambda presents it when
# reporting a finished resize back to the app. Must match the function's own
# INTERNAL_CALLBACK_TOKEN environment variable (see infra/aws/README.md).
#
# There is no RESIZE_LAMBDA_NAME or resize dimension here: the app never invokes
# the function, S3 does, and the output size is set on the function itself
# (MAX_IMAGE_DIMENSION).
INTERNAL_CALLBACK_TOKEN=change-me-internal-token
