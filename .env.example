DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AWS_REGION=us-east-1
AWS_S3_BUCKET=dashboard-documents

# Per-user cap on document + image storage within a single project, in bytes.
# A resized image counts twice: the original is kept as the resize source.
# Default: 10 MB.
MAX_USER_UPLOAD_BYTES_PER_PROJECT=10485760

# The resize Lambda, invoked synchronously by POST /image/{id}/resize.
RESIZE_LAMBDA_NAME=dashboard-resize-image
# Ceiling on the width/height a caller may request.
MAX_RESIZE_DIMENSION=4096
DEFAULT_RESIZE_DIMENSION=512

# Shared secret for /internal/... - the Lambda no longer calls back (it returns
# its result directly), so this now only guards the manual override endpoint.
INTERNAL_CALLBACK_TOKEN=change-me-internal-token
