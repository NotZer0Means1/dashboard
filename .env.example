DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dashboard
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STORAGE_DIR=storage

# Set STORAGE_BACKEND=s3 to use S3 instead of local disk storage.
STORAGE_BACKEND=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=dashboard-documents

# Per-user cap on document storage within a single project, in bytes. Default: 10 MB.
MAX_USER_UPLOAD_BYTES_PER_PROJECT=10485760
